# OmniWatch server environment. Copy to .env and fill in what you need.
# Everything is optional: without keys, sources are reported as "disabled" with a reason.
# NEVER commit .env. See docs/DEPLOYMENT.md.

# --- Server ---
PORT=4100
NODE_ENV=development
REFRESH_INTERVAL_MINUTES=15
HISTORY_DB_PATH=./data/omniwatch.db
HISTORY_RETENTION_DAYS=30

# --- Security ---
# When set, POST /api/sweep and /api/alert-rules + /api/admin/keys require x-admin-key.
ADMIN_API_KEY=
# Comma-separated allowed origins. Default: '*' in development, deny-remote in production.
CORS_ORIGIN=
# Set to true to require an issued API key (Authorization: Bearer ow_...) on public API reads.
REQUIRE_API_KEY=false
RATE_LIMIT_PER_MIN=120
CHAT_RATE_LIMIT_PER_MIN=10
MAX_SSE_CLIENTS=50
# Set to 1 behind a reverse proxy so per-IP rate limiting sees the real client IP.
TRUST_PROXY=

# --- LLM (J.A.R.V.I.S chat + correlation) ---
# Local Ollama default; for Ollama Cloud use https://ollama.com plus OLLAMA_API_KEY.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_API_KEY=

# --- OpenSky Network (OAuth2 client credentials only; username/password no longer works) ---
# https://opensky-network.org/my-opensky/account -> API clients
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Bounding box required for the 15s live refresh so credit use stays bounded.
# Format: lamin=50&lomin=0&lamax=52&lomax=2 (SSE: lamin,lomin,lamax,lomax)
OPENSKY_BBOX=
# Anonymous mode is credit-metered and blocked on many clouds; opt-in only.
OPENSKY_ALLOW_ANONYMOUS=false

# --- AISStream (free WebSocket AIS; https://aisstream.io) ---
AISSTREAM_API_KEY=
# Optional JSON bounding boxes: [[[latMin,lonMin],[latMax,lonMax]], ...]
AISSTREAM_BBOXES=
# How long a last-known vessel position stays visible (ms).
AIS_SNAPSHOT_TTL_MS=600000
# Verified MMSI list (comma-separated) to track specific hulls (e.g. carriers) via AIS.
CARRIER_MMSIS=

# --- Key-gated sources (each is reported "disabled" until its key is set) ---
# FIRMS_MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# FRED_API_KEY: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# FINNHUB_API_KEY: https://finnhub.io (free tier does not include index quotes like VIX)
FINNHUB_API_KEY=
# EIA v2 API key: https://www.eia.gov/opendata/
EIA_API_KEY=
# ACLED registration: https://acleddata.com/registration (both values required)
ACLED_API_KEY=
ACLED_EMAIL=
# Cloudflare Radar: https://developers.cloudflare.com/radar/
CLOUDFLARE_API_TOKEN=
# Global Fishing Watch token: https://globalfishingwatch.org/our-apis/
GFW_API_KEY=
# OpenAQ v3 key: https://explore.openaq.org/account
OPENAQ_API_KEY=
# PatentsView: https://patentsview.org/apis/keyrequest
PATENTSVIEW_API_KEY=
# Reddit OAuth2 app (unauthenticated .json is blocked since 2026-05-28)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optional live sources ---
# OSM Overpass power-plant queries time out on public instances; opt in only if you have capacity.
ENABLE_OVERPASS_POWERPLANTS=false

# --- Alerts (all optional; without channels, rules are stored but not delivered) ---
# Generic or Discord-compatible webhook.
ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
